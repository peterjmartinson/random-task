    "commander": "^13.1.0",
    "date-fns": "^4.1.0",
    "fast-levenshtein": "^3.0.0",
    "node-ical": "^0.27.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/fast-levenshtein": "^0.0.4",
    "@types/node": "^22.13.4",
    "@vercel/node": "^9.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
