  "version": "1.0.0",
  "description": "CLI utility to scrape, aggregate, and normalize daily schedules and tasks into a unified JSON agenda",
  "main": "dist/index.js",
  "bin": {
    "agenda-aggregator": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx src/cli.ts",
    "test": "vitest run"
  },
  "keywords": [
